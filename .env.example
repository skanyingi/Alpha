# Copy to .env. Never commit live keys.
CATMOD_HDC_DIM=10000
CATMOD_HDC_SEED=42
CATMOD_CLEAN_CONFIDENCE_THRESHOLD=0.95

# Optional hosted Jev (TypeSafe System-One). Local lexicon+rules run if unset.
JEV_API_KEY=
JEV_BASE_URL=https://jevtypesafeai.com/api/v1/decide
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=400

# Flood exposure layer (does not affect XL payouts)
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CATMOD_FLOOD_WSE_M=2.5
CATMOD_SHADER_PRESET=PHOTOREAL_DEFAULT
OPEN_BUILDINGS_PATH=
OPEN_BUILDINGS_GEOJSON_URL=

# Default occurrence XL: $100M xs $40M, 90% reinsurer share, 1 reinstatement at 100% AP
CATMOD_DEFAULT_ATTACHMENT=40000000
CATMOD_DEFAULT_LIMIT=100000000
CATMOD_DEFAULT_COPART=0.90
CATMOD_DEFAULT_REINSTATEMENT_RATE=1.0
CATMOD_DEFAULT_REINSTATEMENTS=1
CATMOD_DEFAULT_LAYER_PREMIUM=5000000
